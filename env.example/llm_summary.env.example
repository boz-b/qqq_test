# Copy this file to env/llm_summary.env before enabling Gemini daily news summaries.
# Keep the copied env/llm_summary.env file private because it will contain the real API key.

LLM_SUMMARY_ENABLED=0
# Set to 1 only after GEMINI_API_KEY is filled in and you want cron to use AI summaries.

LLM_SUMMARY_PROVIDER=gemini
# The qqq_test implementation supports Gemini Developer API via REST, without a Google SDK dependency.

GEMINI_API_KEY=put-your-gemini-api-key-here
# Paste the Google AI Studio / Gemini API key here only in env/llm_summary.env, never in this committed template.

GEMINI_MODEL=gemini-flash-latest
# Cheap/fast Gemini Flash alias from Google's REST quickstart; you can switch to gemini-3-flash-preview if desired.

GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
# Default Gemini Developer API REST base URL.

LLM_SUMMARY_TIMEOUT_SECONDS=45
# Limit each summary API request so cron jobs do not hang forever if Gemini is slow.

LLM_SUMMARY_MAX_CANDIDATE_ITEMS=80
# Cap the combined Finnhub + FinancialJuice candidates sent to Gemini each day so free-tier usage stays controlled.

LLM_SUMMARY_START_DATE=2026-05-14
# Do not ask Gemini to summarize older historical dates; cron should only summarize the current market day from here forward.

NEWS_REQUEST_CACHE_TTL_DAYS=7
# Keep raw Finnhub/API response cache rows only briefly in ignored local data/news_request_cache.csv.

FINANCIALJUICE_FEED_ENABLED=1
# Keep the public FinancialJuice RSS breaking-news feed enabled so Gemini can include same-day breaking headlines.

FINANCIALJUICE_FEED_URL=https://www.financialjuice.com/feed.ashx?xy=pss
# Public RSS feed requested for breaking macro/market headlines; change only if FinancialJuice changes the endpoint.

FINANCIALJUICE_MAX_ITEMS_PER_DAY=100
# Feed up to this many same-day FinancialJuice RSS items into the candidate pool before Gemini's total candidate cap applies.

FINANCIALJUICE_FEED_TIMEOUT_SECONDS=20
# Limit the public RSS request so cron can continue with Finnhub only if FinancialJuice is slow.

LLM_SUMMARY_MAX_BULLETS=7
# Ask Gemini for a compact number of daily bullets before mixing them with macro-calendar rows.

LLM_SUMMARY_TEMPERATURE=0.2
# Keep generation low-temperature so summaries stay factual and repeatable.

LLM_SUMMARY_MAX_OUTPUT_TOKENS=2048
# Give Gemini enough room to return closed valid JSON when many breaking-news candidates are included.

LLM_SUMMARY_THINKING_BUDGET=0
# Keep hidden Gemini thinking disabled so the output budget is used for visible JSON summaries.

LLM_CALENDAR_ACTUALS_ENABLED=1
# When Gemini summaries are enabled, nightly cron can also use Gemini Search to fill released macro-calendar Actual values.

LLM_CALENDAR_ACTUALS_DELAY_MINUTES=20
# Wait this many minutes after a scheduled event time before searching for the reported actual value.

LLM_CALENDAR_ACTUALS_MAX_EVENTS_PER_DAY=8
# Bound the number of blank Actual macro rows checked in one nightly cron run.

LLM_CALENDAR_ACTUALS_TIMEOUT_SECONDS=60
# Limit the Gemini Search lookup so cron can continue if grounding is slow.

LLM_CALENDAR_ACTUALS_QUOTA_BACKOFF_HOURS=12
# After a Gemini 429 quota/rate-limit response, skip further actual lookups for this many hours.
