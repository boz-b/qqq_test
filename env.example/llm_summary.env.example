# Copy this file to env/llm_summary.env before enabling the optional part-6 AI summary feature.
# Keep the copied env/llm_summary.env file private because it will contain the real AI API key.

LLM_SUMMARY_ENABLED=0
# Keep summaries disabled until part 6 is implemented and tested with a real provider key.

LLM_SUMMARY_PROVIDER=openai-compatible
# Use openai-compatible for cheap providers that expose a Chat Completions style HTTP API.

LLM_SUMMARY_API_BASE=https://api.example.com/v1
# Replace this with the provider base URL, for example an OpenRouter, DeepSeek, Groq, Together, or similar endpoint.

LLM_SUMMARY_API_KEY=put-your-ai-api-key-here
# Replace this placeholder with the real key only in env/llm_summary.env, never in this committed template.

LLM_SUMMARY_MODEL=put-cheap-summary-model-here
# Replace this with the cheap model name chosen for daily brief summarization.

LLM_SUMMARY_TIMEOUT_SECONDS=45
# Limit each summary API request so cron jobs do not hang forever if the provider is slow.

LLM_SUMMARY_MAX_CANDIDATE_ITEMS=40
# Cap the number of raw news candidates sent to the model so summary cost stays controlled.

LLM_SUMMARY_MAX_BULLETS=7
# Ask the model for a compact number of daily bullets before mixing them with macro-calendar rows.

LLM_SUMMARY_TEMPERATURE=0.2
# Keep generation low-temperature so summaries stay factual and repeatable.
