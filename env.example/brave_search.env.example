# Copy this file to env/brave_search.env before enabling Brave Search
# macro-calendar actual-value lookup. Keep the copied file private.

LLM_CALENDAR_ACTUALS_PROVIDER=brave
LLM_CALENDAR_ACTUALS_ENABLED=0
# Set to 1 only after BRAVE_SEARCH_API_KEY is configured and tested.

BRAVE_SEARCH_API_KEY=your_brave_search_api_key_here
BRAVE_SEARCH_API_URL=https://api.search.brave.com/res/v1/web/search

BRAVE_SEARCH_TIMEOUT_SECONDS=30
BRAVE_SEARCH_COUNTRY=US
BRAVE_SEARCH_LANG=en
BRAVE_SEARCH_UI_LANG=en-US
BRAVE_SEARCH_SAFESEARCH=moderate
BRAVE_SEARCH_RESULT_COUNT=10
BRAVE_SEARCH_EXTRA_SNIPPETS=true

LLM_CALENDAR_ACTUALS_DELAY_MINUTES=20
# Wait this long after the scheduled release before searching for Actual values.

LLM_CALENDAR_ACTUALS_MAX_EVENTS_PER_DAY=3
BRAVE_SEARCH_MAX_REQUESTS_PER_DAY=3
# Brave uses one bounded web-search request per eligible event. Both caps apply across repeated runs.

BRAVE_SEARCH_CACHE_TTL_HOURS=168
BRAVE_SEARCH_NEGATIVE_CACHE_TTL_HOURS=6
# Cache confident values and short-lived no-result outcomes to avoid duplicate paid searches.

LLM_CALENDAR_ACTUALS_QUOTA_BACKOFF_HOURS=24
# After a Brave HTTP 429, skip more actual lookups for this long.
