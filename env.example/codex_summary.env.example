# Non-secret override; copy to env/codex_summary.env after reviewed deployment.
# Loads before llm_summary.env. Retain that private file for Gemini rollback.
LLM_SUMMARY_ENABLED=0
LLM_SUMMARY_PROVIDER=codex

# Use the absolute path from `command -v codex` for unattended launchd runs.
# The installed CLI must be signed in with ChatGPT as the publishing user.
CODEX_SUMMARY_COMMAND=codex
CODEX_SUMMARY_TIMEOUT_SECONDS=180

# The implementation pins gpt-6-luna and medium reasoning.
# Existing LLM_SUMMARY_MAX_CANDIDATE_ITEMS, LLM_SUMMARY_MAX_BULLETS,
# LLM_SUMMARY_START_DATE, and FinancialJuice settings still apply.
# No API key goes in this file. Subscription allowance is consumed.
