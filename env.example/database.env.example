# Copy this file to env/database.env before running database migrations.
# Keep the copied env/database.env file private if it contains credentials.

DATABASE_URL=postgresql://qqq_test:change-me@localhost:5432/qqq_test
# PostgreSQL connection string used by scripts/db_migrate.py and future DB import/export tools.

QQQ_DATA_BACKEND=csv
# csv is the safe default. Use postgres only for opt-in DB-backed export validation after migration/backfill.

QQQ_CRON_DATA_BACKEND=csv
# Cron export also stays on csv by default. Set to postgres only after DB backfill/parity has been validated.
