# Copy this file to env/calendar_actuals.env before enabling Gemini Search
# macro-calendar actual-value lookup. Keep the copied file private.

LLM_CALENDAR_ACTUALS_PROVIDER=gemini

GEMINI_CALENDAR_ACTUALS_API_KEY=your_actuals_search_gemini_key_here
# Use a separate Google/Gemini API key or project from the news summary key.

GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
# Normal Gemini REST API base URL; not a secret.

LLM_CALENDAR_ACTUALS_ENABLED=0
# Set to 1 only when you want cron to spend Gemini Search grounding quota.

GEMINI_CALENDAR_ACTUALS_MODEL=gemini-flash-latest
# Model used for Search-grounded actual lookups.

LLM_CALENDAR_ACTUALS_TIMEOUT_SECONDS=60
# Limit the Search-grounded request so cron can continue if Gemini is slow.

LLM_CALENDAR_ACTUALS_DELAY_MINUTES=20
# Wait this long after the scheduled release before searching for Actual values.

LLM_CALENDAR_ACTUALS_MAX_EVENTS_PER_DAY=3
# Keep Search-grounded actual lookup small; raise only after quota is confirmed.

LLM_CALENDAR_ACTUALS_MAX_OUTPUT_TOKENS=2048
# Give Gemini enough room to return JSON for the searched actual rows.

LLM_CALENDAR_ACTUALS_THINKING_BUDGET=0
# Keep hidden thinking disabled so output budget is used for visible JSON.

LLM_CALENDAR_ACTUALS_QUOTA_BACKOFF_HOURS=24
# After a 429 for this actuals key, skip more actual lookups for this long.
